# Use the same hostname (localhost) as the Vite dev server, not 127.0.0.1 -
# the backend's session cookie is SameSite=Lax, and browsers treat
# "localhost" and "127.0.0.1" as different sites, which silently drops the
# cookie on cross-site fetches even though CORS allows the request.
VITE_API_BASE_URL=http://localhost:5000/api/v1
