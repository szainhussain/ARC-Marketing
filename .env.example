# Copy to .env and fill in real values for your environment.
# Never commit the real .env file.

# --- Core app ---
FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=change-me-to-a-random-64-char-value
DEBUG=true

# --- Database ---
# Local quick-start uses SQLite by default. For Postgres (docker-compose or
# production) set e.g.:
# DATABASE_URL=postgresql://harness:harness@localhost:5432/marketing_harness
DATABASE_URL=sqlite:///dev.db

# --- CORS (frontend origin allowed to call the API) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Sessions / CSRF ---
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# --- AI provider (optional) ---
# If left blank / unconfigured, AI-dependent workflow stages run in a
# documented "capability_unavailable" state instead of fabricating output.
# AI_PROVIDER selects which section below is used: "anthropic" or "groq".
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5

# Groq (used when AI_PROVIDER=groq) - OpenAI-compatible API, free tier
# available. Get a key at https://console.groq.com -> API Keys.
GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b

AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=60
AI_WORKFLOW_BUDGET_USD=1.00

# --- Usage / governance defaults ---
ORG_DEFAULT_MONTHLY_WORKFLOW_LIMIT=20
KILL_SWITCH_ENABLED=false

# --- File storage (local dev only; use private object storage in production) ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10
